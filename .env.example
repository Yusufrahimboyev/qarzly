# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
# MAJBURIY: botdan va Mini App API'sidan foydalana oladigan Telegram ID lar.
# Bo'sh bo'lsa ilova ishga tushmaydi (fail-closed).
ADMIN_IDS=123456789,987654321
# Faqat development uchun: ADMIN_IDS bo'sh bo'lganda ham hammaga ruxsat beradi.
# Productionda HAR DOIM false bo'lishi kerak.
ALLOW_OPEN_ACCESS=false

# --- Web / hosting ---
PORT=8080
RENDER_EXTERNAL_URL=
# Bitta foydalanuvchi/IP uchun daqiqadagi API so'rovlar chegarasi
API_RATE_LIMIT_PER_MINUTE=120
# Telegram initData amal qilish muddati (soniya)
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=60
# Startupda versiyalangan migratsiyalarni bajarish (deploy job'da alohida
# bajariladigan bo'lsa false qiling)
APPLY_MIGRATIONS=true

# --- Logging ---
LOG_LEVEL=INFO
# Structured (JSON) loglar — log agregatorlar uchun
LOG_JSON=false

# --- Kunlik hisobot (kanalga avtomatik yuborish) ---
# Private kanal ID si (-100 bilan boshlanadi). Bo'sh yoki 0 bo'lsa
# kunlik yuborish o'chiriladi. Bot kanalda admin bo'lishi shart.
REPORT_CHANNEL_ID=
# Hisobot qamrab oladigan davrning boshlanish sanasi (o'zgarmaydi).
REPORT_START_DATE=2026-08-18
# Yuborish vaqti (Asia/Tashkent).
REPORT_SEND_HOUR=23
REPORT_SEND_MINUTE=59
